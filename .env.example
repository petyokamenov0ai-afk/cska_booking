# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml (postgres:16, db cska_booking, user/pass cska/cska).
DATABASE_URL="postgresql://cska:cska@localhost:5432/cska_booking?schema=public"

# --- Cron -------------------------------------------------------------------
# Shared secret for POST /api/cron/expire (sent as the `x-cron-secret` header).
CRON_SECRET="dev-cron-secret-change-me"

# --- App --------------------------------------------------------------------
# 'bg' | 'en'
NEXT_PUBLIC_DEFAULT_LOCALE=bg

# --- Auth -------------------------------------------------------------------
# HMAC key for the staff-login cookie (lib/auth.ts). REQUIRED in production —
# without it a documented fallback secret is used and tokens are forgeable.
AUTH_SECRET=change-me

# Staff login seeded by prisma/seed.ts (upserted on every deploy).
# Defaults: meto / R3brenie_ — override here to rotate without a code change.
#ADMIN_USERNAME=meto
#ADMIN_PASSWORD=R3brenie_
