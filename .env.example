# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml (postgres:16, db cska_booking, user/pass cska/cska).
DATABASE_URL="postgresql://cska:cska@localhost:5432/cska_booking?schema=public"

# --- Cron -------------------------------------------------------------------
# Shared secret for POST /api/cron/expire (sent as the `x-cron-secret` header).
CRON_SECRET="dev-cron-secret-change-me"

# --- App --------------------------------------------------------------------
# 'bg' | 'en'
NEXT_PUBLIC_DEFAULT_LOCALE=bg
